FROM dunglas/frankenphp:1-php8.4-bookworm

WORKDIR /app

# CodeIgniter requires intl and MySQLi. Composer needs zip to install locked
# packages. MariaDB provides a private MySQL-compatible database for the
# read-only hosted demonstration and is initialized from the submitted export.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        mariadb-client \
        mariadb-server \
    && install-php-extensions intl mysqli zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --optimize-autoloader

COPY . .
COPY Caddyfile /etc/caddy/Caddyfile

RUN rm -f .env .env.local \
    && mkdir -p \
    writable/cache \
    writable/logs \
    writable/session \
    writable/uploads \
    && chown -R www-data:www-data writable \
    && chmod +x /app/docker/vercel-entrypoint.sh

ENV CI_ENVIRONMENT=production \
    POS_EMBEDDED_DB=1 \
    PORT=80

CMD ["/app/docker/vercel-entrypoint.sh"]
